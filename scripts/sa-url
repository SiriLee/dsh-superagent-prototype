#!/usr/bin/env python3
"""Print the dsh-superagent panel URL of the running instance.

The URL carries a per-process token. Opening it once exchanges the token for a
long-lived session cookie, after which the credential-free URL works in that
browser; a restart prints a new token but the cookie usually keeps working.

Usage: scripts/sa-url
Exit codes: 0 URL printed and the port is listening; 1 no URL found or the
service is not listening (the reason is printed to stderr).
"""

from pathlib import Path
import re
import socket
import sys
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parent.parent
PATTERN = re.compile(r'http://127\.0\.0\.1:\d+/\?token=[A-Za-z0-9_-]+')


def newest_log_with_url() -> str | None:
    """Return the panel URL from the newest log that has one, or None."""
    logs = (ROOT / '.artifacts').glob('dsh-superagent-*.log')
    for log in sorted(logs, key=lambda path: path.stat().st_mtime, reverse=True):
        try:
            match = PATTERN.search(log.read_text(errors='ignore'))
        except OSError:
            continue
        if match:
            return match.group(0)
    return None


def listening(url: str) -> bool:
    """Return whether something accepts connections at the URL's address."""
    parsed = urlparse(url)
    try:
        with socket.create_connection((parsed.hostname or '127.0.0.1', parsed.port or 80), timeout=1):
            return True
    except OSError:
        return False


def main() -> int:
    url = newest_log_with_url()
    if url is None:
        print(f'No panel URL found in {ROOT}/.artifacts/*.log; start the service first.', file=sys.stderr)
        return 1
    print(url)
    if not listening(url):
        print('dsh-superagent is not listening at that address; run scripts/dsh-superagent start.', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
